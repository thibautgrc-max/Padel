/* --- On-demand CTA + modal --- */
.onDemand{
  margin-top:14px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  padding:14px;
  border-radius:22px;
  border:1px solid rgba(255,255,255,.12);
  background:
    radial-gradient(700px 180px at 10% 0%, rgba(124,92,255,.18), transparent 55%),
    radial-gradient(700px 180px at 90% 0%, rgba(0,224,255,.12), transparent 55%),
    rgba(255,255,255,.04);
}

.onDemand .txt{
  min-width:0;
}
.onDemand .txt b{
  display:block;
  font-size:14px;
}
.onDemand .txt span{
  display:block;
  color:var(--muted2);
  font-size:12.5px;
  margin-top:4px;
}

.btn-glow{
  background: linear-gradient(135deg, rgba(124,92,255,1), rgba(0,224,255,1));
  color:#071018;
  border:1px solid rgba(255,255,255,.22);
  box-shadow: 0 18px 60px rgba(124,92,255,.20);
}
.btn-glow:hover{
  transform:translateY(-1px);
  box-shadow: 0 22px 75px rgba(0,224,255,.18);
}

/* modal */
.modal{
  position:fixed; inset:0;
  display:none;
  align-items:center; justify-content:center;
  padding:18px;
  background: rgba(0,0,0,.62);
  backdrop-filter: blur(10px);
  z-index:80;
}
.modal[open]{display:flex;}
.modal-card{
  width:min(760px, 100%);
  border-radius:24px;
  border:1px solid rgba(255,255,255,.14);
  background: rgba(7,10,18,.92);
  box-shadow: 0 30px 110px rgba(0,0,0,.65);
  overflow:hidden;
}
.modal-top{
  padding:16px 16px 12px;
  display:flex; align-items:flex-start; justify-content:space-between; gap:12px;
  border-bottom:1px solid rgba(255,255,255,.10);
}
.modal-top h3{margin:0; font-size:16px}
.modal-top p{margin:6px 0 0; color:var(--muted); font-size:13.5px}
.modal-body{padding:14px 16px 16px;}
.choice-grid{
  display:grid;
  grid-template-columns: repeat(3, 1fr);
  gap:10px;
}
.choice{
  border-radius:16px;
  border:1px solid rgba(255,255,255,.10);
  background: rgba(255,255,255,.04);
  padding:12px;
}
.choice b{display:block; font-size:13.5px}
.choice span{display:block; color:var(--muted2); font-size:12px; margin-top:4px}
.modal-actions{
  margin-top:12px;
  display:flex; gap:10px; flex-wrap:wrap; align-items:center;
}
.xbtn{
  border-radius:999px;
  padding:10px 12px;
  border:1px solid rgba(255,255,255,.14);
  background: rgba(255,255,255,.04);
  color: rgba(255,255,255,.90);
  cursor:pointer;
}
@media (max-width: 980px){
  .choice-grid{grid-template-columns:1fr}
  .onDemand{flex-direction:column; align-items:flex-start}
}
